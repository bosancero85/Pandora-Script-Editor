{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "use_ssl": {"type": "boolean"},
        "log_level": {"type": "string", "enum": ["debug", "info", "warning", "error"]},
        "max_connections": {"type": "integer", "minimum": 1}
      },
      "required": ["host", "port"]
    },
    "database": {
      "type": "object",
      "properties": {
        "engine": {"type": "string", "enum": ["sqlite", "postgresql", "mysql"]},
        "path": {"type": "string"},
        "timeout_seconds": {"type": "number"}
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "dark_mode": {"type": "boolean"},
        "beta_updates": {"type": "boolean"}
      }
    }
  },
  "required": ["server"]
}
